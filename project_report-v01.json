{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Report",
  "type": "object",
  "required": [
    "organization",
    "recipient",
    "document",
    "sections"
  ],
  "properties": {
    "organization": {
      "type": "object",
      "title": "Organization",
      "required": [
        "name",
        "address",
        "email",
        "phone"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Name"
        },
        "address": {
          "type": "string",
          "title": "Address"
        },
        "email": {
          "type": "string",
          "title": "Email",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "title": "Phone"
        }
      },
      "additionalProperties": false
    },
    "recipient": {
      "type": "object",
      "title": "Recipient",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Name"
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "title": "Document",
      "required": [
        "id",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "Document ID"
        },
        "date": {
          "type": "string",
          "title": "Date"
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "title": "Sections",
      "required": [
        "show_summary",
        "show_milestones",
        "show_risks",
        "show_budget",
        "show_approval",
        "show_notes"
      ],
      "properties": {
        "show_summary": {
          "type": "boolean",
          "title": "Show Executive Summary",
          "default": true
        },
        "show_milestones": {
          "type": "boolean",
          "title": "Show Milestones",
          "default": true
        },
        "show_risks": {
          "type": "boolean",
          "title": "Show Risk Register",
          "default": true
        },
        "show_budget": {
          "type": "boolean",
          "title": "Show Budget Snapshot",
          "default": false
        },
        "show_approval": {
          "type": "boolean",
          "title": "Show Approval",
          "default": true
        },
        "show_notes": {
          "type": "boolean",
          "title": "Show Notes",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "title": "Executive Summary"
    },
    "milestones": {
      "type": "array",
      "title": "Milestones",
      "items": {
        "type": "object",
        "required": [
          "name",
          "owner",
          "status",
          "due_date"
        ],
        "properties": {
          "name": {
            "type": "string",
            "title": "Milestone"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "due_date": {
            "type": "string",
            "title": "Due Date"
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "title": "Risk Register",
      "items": {
        "type": "object",
        "required": [
          "level",
          "description"
        ],
        "properties": {
          "level": {
            "type": "string",
            "title": "Level"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "budget": {
      "type": "object",
      "title": "Budget",
      "required": [
        "currency",
        "approved",
        "spent"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "title": "Currency"
        },
        "approved": {
          "type": "string",
          "title": "Approved Budget"
        },
        "spent": {
          "type": "string",
          "title": "Spent to Date"
        }
      },
      "additionalProperties": false
    },
    "approver": {
      "type": "object",
      "title": "Approver",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Approver Name"
        },
        "role": {
          "type": "string",
          "title": "Approver Role"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "title": "Notes",
      "items": {
        "type": "string",
        "title": "Note"
      },
      "default": []
    }
  },
  "additionalProperties": false
}
