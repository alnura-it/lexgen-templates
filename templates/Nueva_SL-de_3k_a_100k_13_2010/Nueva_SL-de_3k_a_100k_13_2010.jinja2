{% set defaults = {
  "encabezado": {
    "numero_escritura": "NUMERO: 0001",
    "city": "Almoradi",
    "grant_date": "14 de septiembre de 2026",
    "notary_name": "Luis Lorenzo Serra",
    "notary_college": "Ilustre Colegio de Valencia"
  },
  "sociedad": {
    "company_name": "Ejemplo Sociedad Limitada",
    "duration": "indefinida",
    "registered_address": "Almoradi (Alicante)",
    "social_object": "Servicios profesionales"
  },
  "estatutos": {
    "statute_folios": 8,
    "statute_series": "A",
    "statute_numbers": "1001-1008"
  },
  "capital": {
    "capital_total_eur": 3000,
    "shares_total": 300,
    "share_nominal_eur": 10
  },
  "administracion": {
    "administrator_scope": "administrador unico",
    "administrator_term": "INDEFINIDO",
    "administrator_name": "Pendiente de designacion"
  },
  "fiscalidad": {
    "tax_exemption_article": "Articulo 45.1B.11"
  },
  "otorgamiento": {
    "notary_address": "calle Mayor, numero 18-1, Almoradi (Alicante)",
    "matrix_folios_total": 11,
    "matrix_series": "A",
    "matrix_following_folios": 10
  },
  "watermark": {
    "show": true,
    "text": "BORRADOR"
  }
} %}

{% set numero_escritura = numero_escritura | default(defaults.encabezado.numero_escritura) %}
{% set city = city | default(defaults.encabezado.city) %}
{% set grant_date = grant_date | default(defaults.encabezado.grant_date) %}
{% set notary_name = notary_name | default(defaults.encabezado.notary_name) %}
{% set notary_college = notary_college | default(defaults.encabezado.notary_college) %}

{% set company_name = company_name | default(defaults.sociedad.company_name) %}
{% set duration = duration | default(defaults.sociedad.duration) %}
{% set registered_address = registered_address | default(defaults.sociedad.registered_address) %}
{% set social_object = social_object | default(defaults.sociedad.social_object) %}

{% set statute_folios = statute_folios | default(defaults.estatutos.statute_folios) %}
{% set statute_series = statute_series | default(defaults.estatutos.statute_series) %}
{% set statute_numbers = statute_numbers | default(defaults.estatutos.statute_numbers) %}

{% set capital_total_eur = capital_total_eur | default(defaults.capital.capital_total_eur) %}
{% set shares_total = shares_total | default(defaults.capital.shares_total) %}
{% set share_nominal_eur = share_nominal_eur | default(defaults.capital.share_nominal_eur) %}

{% set administrator_scope = administrator_scope | default(defaults.administracion.administrator_scope) %}
{% set administrator_term = administrator_term | default(defaults.administracion.administrator_term) %}
{% set administrator_name = administrator_name | default(defaults.administracion.administrator_name) %}

{% set tax_exemption_article = tax_exemption_article | default(defaults.fiscalidad.tax_exemption_article) %}

{% set notary_address = notary_address | default(defaults.otorgamiento.notary_address) %}
{% set matrix_folios_total = matrix_folios_total | default(defaults.otorgamiento.matrix_folios_total) %}
{% set matrix_series = matrix_series | default(defaults.otorgamiento.matrix_series) %}
{% set matrix_following_folios = matrix_following_folios | default(defaults.otorgamiento.matrix_following_folios) %}

{% set show_draft_watermark = show_draft_watermark | default(defaults.watermark.show) %}
{% set draft_watermark_text = draft_watermark_text | default(defaults.watermark.text) %}

{% set visible_sections = visible_sections | default({}) %}
{% set sections = {
  "comparecencia": visible_sections.get("comparecencia", true),
  "primero_constitucion": visible_sections.get("primero_constitucion", true),
  "segundo_capital": visible_sections.get("segundo_capital", true),
  "tercero_administracion": visible_sections.get("tercero_administracion", true),
  "cuarto_estipulaciones": visible_sections.get("cuarto_estipulaciones", true),
  "quinto_inhabilidades": visible_sections.get("quinto_inhabilidades", true),
  "sexto_certificacion": visible_sections.get("sexto_certificacion", true),
  "septimo_tramitacion": visible_sections.get("septimo_tramitacion", true),
  "octavo_copia": visible_sections.get("octavo_copia", true),
  "noveno_subsanacion": visible_sections.get("noveno_subsanacion", true),
  "decimo_exenciones": visible_sections.get("decimo_exenciones", true),
  "otorgamiento_autorizacion": visible_sections.get("otorgamiento_autorizacion", true),
  "firmas": visible_sections.get("firmas", true)
} %}

{% set comparecientes = comparecientes | default([]) %}
{% set socios = socios | default([]) %}
{% set signatories = signatories | default([]) %}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Escritura de Constitucion - {{ company_name }}</title>
  <style>
    body { font-family: "Times New Roman", serif; margin: 36px; line-height: 1.4; }
    h1, h2 { text-align: center; margin: 0.2rem 0; }
    .watermark {
      position: fixed;
      top: 45%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-28deg);
      color: rgba(160, 160, 160, 0.25);
      font-size: 84px;
      font-weight: 700;
      letter-spacing: 8px;
      z-index: 0;
      pointer-events: none;
      user-select: none;
      white-space: nowrap;
    }
    .content { position: relative; z-index: 1; }
    .section-title { font-weight: 700; text-transform: uppercase; }
    .signature-grid { margin-top: 28px; }
    .signature-line { margin-top: 28px; }
  </style>
</head>
<body>
  {% if show_draft_watermark %}
  <div class="watermark">{{ draft_watermark_text }}</div>
  {% endif %}

  <div class="content">
    <h1>ESCRITURA DE CONSTITUCION DE SOCIEDAD DE RESPONSABILIDAD LIMITADA</h1>
    <h2>REAL DECRETO 13/2010</h2>
    <p><strong>{{ numero_escritura }}</strong></p>
    <p>En {{ city }}, mi residencia, a {{ grant_date }}.</p>
    <p>Ante mi, {{ notary_name }}, Notario del {{ notary_college }}.</p>

    {% if sections.comparecencia %}
    <p class="section-title">COMPARECEN:</p>
    {% for compareciente in comparecientes %}
    <p>
      {{ loop.index | upper }}) {{ compareciente.full_name | default("Pendiente") }},
      {{ compareciente.id_document_type | default("DNI") }} {{ compareciente.id_document | default("Pendiente") }},
      con domicilio en {{ compareciente.address | default("Pendiente") }}.
    </p>
    {% else %}
    <p>Sin comparecientes informados en los datos de entrada.</p>
    {% endfor %}
    <p>Les juzgo con capacidad legal suficiente para formalizar la presente escritura.</p>
    <p class="section-title">EXPONEN:</p>
    {% endif %}

    {% if sections.primero_constitucion %}
    <p class="section-title">PRIMERO.- CONSTITUCION Y ESTATUTOS DE "{{ company_name }}".</p>
    <p>
      Los comparecientes constituyen una sociedad de responsabilidad limitada de duracion {{ duration }},
      con domicilio en {{ registered_address }}, y con objeto social "{{ social_object }}".
    </p>
    <p>
      Los estatutos entregados para protocolizacion constan de {{ statute_folios }} folios,
      serie {{ statute_series }}, numeros {{ statute_numbers }}.
    </p>
    {% endif %}

    {% if sections.segundo_capital %}
    <p class="section-title">SEGUNDO.- CAPITAL, SUSCRIPCION Y DESEMBOLSO DE LAS PARTICIPACIONES SOCIALES.</p>
    <p>
      El capital social queda fijado en {{ capital_total_eur }} euros, dividido en {{ shares_total }}
      participaciones sociales de valor nominal {{ share_nominal_eur }} euros cada una.
    </p>

    {# Bucle de socios fundadores con detalle de tramos y desembolso #}
    {% for socio in socios %}
    <p>
      {{ socio.label | default("Socio") }} {{ socio.full_name | default("Pendiente") }} suscribe
      {{ socio.shares_subscribed | default(0) }} participaciones, numeros del
      {{ socio.share_from | default(0) }} al {{ socio.share_to | default(0) }},
      por importe de {{ socio.amount_eur | default(0) }} euros, con certificacion de deposito
      en {{ socio.bank_entity | default("Entidad bancaria") }} de fecha
      {{ socio.deposit_date | default("Pendiente") }}.
    </p>
    {% else %}
    <p>Sin socios detallados en los datos de entrada.</p>
    {% endfor %}
    {% endif %}

    {% if sections.tercero_administracion %}
    <p class="section-title">TERCERO.- NOMBRAMIENTO DE ADMINISTRADOR.</p>
    <p>
      Se nombra {{ administrator_scope }} por plazo {{ administrator_term }} a
      {{ administrator_name }}, quien acepta el cargo.
    </p>
    {% endif %}

    {% if sections.cuarto_estipulaciones %}
    <p class="section-title">CUARTO.- ESTIPULACIONES ESPECIALES.</p>
    <p>
      Durante la fase previa a la inscripcion, el organo de administracion ejercera
      las facultades estatutarias y legales con caracter general.
    </p>
    {% endif %}

    {% if sections.quinto_inhabilidades %}
    <p class="section-title">QUINTO.- INHABILIDADES LEGALES. DECLARACION.</p>
    <p>
      No podran ocupar cargos quienes esten incursos en prohibiciones o incompatibilidades
      legales, en especial las previstas en el articulo 230 de la Ley de Sociedades de Capital.
    </p>
    {% endif %}

    {% if sections.sexto_certificacion %}
    <p class="section-title">SEXTO.- CERTIFICACION DEL REGISTRO MERCANTIL CENTRAL.</p>
    <p>
      Se incorpora certificacion vigente de denominacion social negativa obtenida del Registro
      Mercantil Central para la sociedad constituida.
    </p>
    {% endif %}

    {% if sections.septimo_tramitacion %}
    <p class="section-title">SEPTIMO.- TRAMITACION TELEMATICA.</p>
    <p>
      En el dia del otorgamiento se remite copia autorizada electronica al Registro Mercantil
      del domicilio social y se solicita telematicamente el CIF provisional.
    </p>
    {% endif %}

    {% if sections.octavo_copia %}
    <p class="section-title">OCTAVO.- COPIA AUTORIZADA EN SOPORTE PAPEL.</p>
    <p>
      Los comparecientes solicitan copia autorizada completa de la escritura de constitucion.
    </p>
    {% endif %}

    {% if sections.noveno_subsanacion %}
    <p class="section-title">NOVENO.- SUBSANACION.</p>
    <p>
      Los comparecientes atribuyen al notario autorizante la facultad de subsanar
      electronicamente los defectos advertidos en la calificacion registral.
    </p>
    {% endif %}

    {% if sections.decimo_exenciones %}
    <p class="section-title">DECIMO.- EXENCIONES Y BONIFICACIONES.</p>
    <p>
      Se solicita la exencion del concepto operaciones societarias conforme a
      {{ tax_exemption_article }}, asi como las bonificaciones arancelarias aplicables.
    </p>
    {% endif %}

    {% if sections.otorgamiento_autorizacion %}
    <p class="section-title">OTORGAMIENTO Y AUTORIZACION.</p>
    <p>
      Yo, el Notario, realizo las advertencias legales pertinentes, en especial las fiscales
      y registrales. Esta matriz queda extendida en {{ matrix_folios_total }} folios de
      papel timbrado, serie {{ matrix_series }}, y {{ matrix_following_folios }} siguientes.
    </p>
    <p>Direccion de la notaria: {{ notary_address }}.</p>
    {% endif %}

    {% if sections.firmas %}
    <p class="section-title">FIRMAS.</p>
    <div class="signature-grid">
      <p class="signature-line">Notario: {{ notary_name }}</p>
      <p class="signature-line">Administrador designado: {{ administrator_name }}</p>
      {% for signer in signatories %}
      <p class="signature-line">
        Compareciente {{ loop.index }}: {{ signer.full_name | default("Pendiente") }}
        {% if signer.role %}({{ signer.role }}){% endif %}
      </p>
      {% else %}
      <p class="signature-line">Compareciente 1: ________________________________</p>
      <p class="signature-line">Compareciente 2: ________________________________</p>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</body>
</html>
